# 키 이름만. 실제 값은 .env에 (커밋 금지).

# 블로그 작업 폴더 (posts/<슬러그>/ 산출물이 여기 쓰임)
BLOG_DIR=

# 근거 수집용 코드 폴더들 (읽기 전용, 쉼표 구분)
REPO_DIRS=

# Zenn 콘텐츠 리포 로컬 클론 경로 (Galley가 下書き 커밋)
ZENN_CONTENT_DIR=

# SQLite 파일 경로 (Prisma datasource url). file: 프로토콜 + 상대경로 형식.
# 예: DATABASE_URL="file:./dev.db" (schema.prisma 기준 상대경로). 절대경로 하드코딩 금지.
DATABASE_URL=

# 모델 API 키 — 없는 provider의 모델은 실행 Dialog에서 비활성(available:false)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Zenn 연동 리포 push용 토큰 (필요 시)
ZENN_GIT_TOKEN=
