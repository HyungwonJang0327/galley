# 키 이름만. 실제 값은 .env에 (커밋 금지).
# 리포 루트에 .env 하나만 둔다 — 대시보드·Prisma CLI·워커가 모두 이 파일을 읽는다(decisions/env-location.md).

# 블로그 작업 폴더 (posts/<슬러그>/ 산출물이 여기 쓰임)
BLOG_DIR=

# 시간대 (홈 "다음 자동 실행: 수/토 18:00" 계산·표시 기준. Node 표준 변수라 프로세스 전체에 적용)
TZ=Asia/Seoul

# 근거 수집용 코드 폴더들 (읽기 전용, 쉼표 구분)
REPO_DIRS=

# Zenn 콘텐츠 리포 로컬 클론 경로 (Galley가 下書き 커밋)
ZENN_CONTENT_DIR=

# Galley 데이터 폴더 — 근거 수집이 읽은 코드 조각(snippet 포함 EvidenceBundle)을 여기에만 쓴다.
# blog 폴더(BLOG_DIR) 밖이어야 한다(회사 코드 조각이 발행 원고 폴더로 나가지 않게). 예: ~/.galley/data
DATA_DIR=

# 어투 프롬프트 폴더 (선택). 비우면 리포 루트 .galley/prompts ({velog,linkedin,zenn}.md — 사람이 편집, git 이력)
PROMPTS_DIR=

# 식별 정보 필터 설정 파일 경로 (선택). 비우면 리포 루트 .galley/redact.json. 예시: .galley/redact.example.json
REDACT_CONFIG_PATH=

# SQLite 파일 경로 (Prisma datasource url). file: 프로토콜 + 상대경로 형식.
# 예: DATABASE_URL="file:./dev.db" (schema.prisma 기준 상대경로). 절대경로 하드코딩 금지.
DATABASE_URL=

# 모델 API 키 — 없는 provider의 모델은 실행 Dialog에서 비활성(available:false)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Zenn 연동 리포 push용 토큰 (필요 시)
ZENN_GIT_TOKEN=
