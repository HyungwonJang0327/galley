// @galley/pipeline 데이터 접근 계층 스키마.
// 저장: SQLite / ORM: Prisma. 배포 시 provider 한 줄로 Postgres 전환. (decisions/db-access-layer.md)
// 상태값(대기/후보/보류/완료)은 SQLite가 native enum을 지원하지 않으므로
// String 필드 + 애플리케이션 레벨 체크로 표현한다. (스키마에 enum 사용 금지)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 주제 큐 항목. 진실은 주제_큐.md 파일이며 DB는 파생 캐시다. (decisions/queue-sync-direction.md)
model QueueItem {
  id        String   @id @default(cuid())
  title     String
  // 대기 | 후보 | 보류 | 완료 — 값 검증은 애플리케이션 레벨.
  status    String   @default("대기")
  order     Int
  // 보류로 내린 사유: removed-from-file | manual — 보류 탭에서 구분해 보여준다.
  // (decisions/queue-sync-direction.md 사라진 줄 처리)
  holdReason String?

  // 파일에서 사라진 것이 감지된 시각. Run이 붙어 있어 **자동으로 내리지 않고** 확인을 기다리는
  // 항목의 표시다. 줄이 돌아오면 비운다. Run이 없는 항목은 곧바로 보류로 내리므로 여기 남지 않는다.
  missingSince DateTime?

  // 사라진 것을 사람이 확인하고 "그대로 두기"를 고른 시각. 이게 있으면 다시 묻지 않는다.
  // **"보류로 옮기기"에는 쓰이지 않는다** — 그쪽은 줄을 파일에 되살리므로 다음 파싱에서
  // missingSince와 함께 자연스럽게 비워진다. 즉 이 컬럼이 필요한 경우는 "그대로 두기" 하나뿐이다.
  missingAck DateTime?

  // 이 주제의 실행들. 파일에서 사라져도 QueueItem을 지우지 않는 이유다.
  runs Run[]

  // 후보 섹션 ### 소제목(있을 때만). 파서 QueueTopic.category 보존.
  category    String?
  // 완료 항목의 날짜 접두 YYYY-MM-DD(완료 항목만). 파서 QueueTopic.completedOn 보존.
  completedOn String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 섹션(status)별 정렬 조회 편의를 위한 최소 인덱스.
  @@index([status, order])
}

// 주제 하나에 대한 한 번의 실행. 주제는 QueueItem.id가 아니라 제목 파생 슬러그로 가리킨다
// — 큐는 전체 리셋으로 재적재돼 id가 매번 바뀐다. (decisions/queue-sync-direction.md)
model Run {
  id String @id @default(cuid())

  // 주제 키 = QueueItem.id. 내용에서 파생되지 않아 제목·URL 슬러그가 바뀌어도 이력이 끊기지 않는다
  // (decisions/queue-sync-direction.md 2026-09-12 결정 변경). 큐 항목은 파일에서 사라져도 지우지 않는다.
  topicId String
  topic   QueueItem @relation(fields: [topicId], references: [id])

  // 그 실행 시점의 슬러그·제목. **키가 아니라 사실 기록**이다 — 이 Run이 어느 폴더(posts/<슬러그>/)에
  // 썼는지 알아야 하고, 슬러그가 바뀌어도 과거 Run의 폴더는 여전히 옛 슬러그다.
  topicSlug  String
  topicTitle String

  // 이 주제의 몇 번째 시도인가(topicId 기준, 1부터). 재실행은 새 Run이다
  // — decisions/run-execution-model.md. "몇 번 만에 승인됐는가"가 핵심 기록이다.
  attempt Int @default(1)

  // 검수 상태: running | pendingApproval | done | failed — 어휘는 상태 머신 RUN_STATUS가 소유.
  // 저장값은 영어, 화면 한국어 라벨은 앱이 붙인다(decisions/db-value-language.md).
  status String @default("running")

  // 워커 실행 상태: queued | running | interrupted — 대시보드는 queued로만 만든다.
  // (decisions/run-location.md) heartbeat 공백으로 중단을 감지한다.
  workerState String    @default("queued")
  workerId    String?
  heartbeat   DateTime?

  // 이 실행의 기본 모델(레지스트리 id `provider:model`). 단계별로 다를 수 있어 RunStep에도 둔다.
  // (decisions/model-selection.md) 총비용은 저장하지 않고 단계 합으로 구한다.
  modelId String

  // 재실행일 때만 채운다(첫 실행은 둘 다 null). 재실행은 새 Run이고 이 둘이 "왜 여기서부터 다시
  // 돌았는지"를 설명한다 — 시도 이력의 핵심 정보다(decisions/run-execution-model.md).
  // instruction: 사용자가 입력한 수정 지시 **원문 그대로**(정규화하지 않는다). 워커가 StepContext로 넘긴다.
  // startStep: planRerun이 정한 시작 단계(Select 지정이든 텍스트 판단이든 최종 결과만). fresh 행의
  //   첫 번째와 같지만, 이력·타임라인 헤더에서 매번 유도하는 것보다 적어 두는 것이 싸다.
  instruction String?
  startStep   String?

  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  steps RunStep[]

  // 홈·사이드바 카운트(검수 상태별), 주제별 이력 조회(목록은 주제 단위로 묶고 최신 Run을 대표로).
  @@index([status, startedAt])
  @@index([topicId, attempt])
  @@index([topicSlug, startedAt])
}

// 실행 안의 단계 한 줄. 단계 6개(근거 수집·본문·근거 검증·링크드인·Zenn·발행정보)는 이름 문자열로
// 둔다 — SQLite enum 금지 규칙을 지키고, 단계가 늘어도 마이그레이션이 필요 없다.
model RunStep {
  id    String @id @default(cuid())
  runId String
  run   Run    @relation(fields: [runId], references: [id], onDelete: Cascade)

  // evidence | velog | verify | linkedin | zenn | publishInfo — 순서는 order.
  // 어휘와 순서는 상태 머신 STEP_ORDER가 소유하고, 화면 한국어 라벨은 앱이 붙인다.
  name  String
  order Int

  // pending | running | succeeded | failed — 어휘는 상태 머신 STEP_STATUS가 소유.
  status String @default("pending")

  // fresh | carried — 결과 출처(STEP_ORIGIN). status(생명주기)와 **직교한다**:
  // 재실행 중 시작 단계가 실패하면 앞은 carried+succeeded, 시작 단계는 fresh+failed, 뒤는 pending.
  // carried 단계도 새 Run의 행으로 저장한다 — 타임라인이 자기 완결적이어야 하고,
  // 발행정보 근거 목록과의 대조도 같은 Run 안에서 끝나야 한다.
  origin String @default("fresh")

  // carried일 때 그 결과를 생산한 Run. 화면의 "이전 결과 · {시각}"은 이 Run의 완료 시각을
  // **참조**한다(시각을 복사해 두지 않는다 — 원본이 바뀌면 같이 바뀌어야 한다).
  sourceRunId String?

  // 실패 기록 — 셋만 둔다(decisions/error-handling.md "단계 실패 기록").
  // 스택·원본 응답은 여기 넣지 않는다. 그 Run의 로그(posts/<슬러그>/runs/<runId>/)에 남기고
  // 타임라인 실패 줄을 펼치면 그 로그를 보여준다. 행은 가볍게 유지한다.
  // retryable은 별도 컬럼으로 두지 않는다 — errorCode에서 유도한다.
  errorCode    String?
  errorMessage String?

  // 이 단계를 몇 번 시도했는지. 재시도했다면 **마지막 실패만** 위에 남기고 횟수는 여기.
  // "3번 시도 후 실패"를 타임라인에 보여준다. 성공하면 위 둘은 비우고 이 값은 남긴다.
  attemptCount Int @default(0)

  // 이 단계를 실행한 모델과 사용량·비용(재실행 시 단계마다 다를 수 있다).
  modelId      String?
  inputTokens  Int?
  outputTokens Int?
  costUsd      Float?
  durationMs   Int?

  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // 실행 상세 타임라인(순서대로), 재실행 시 단계 찾기.
  @@unique([runId, order])
  @@index([runId, order])
}
